<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16" styleClass="content-area" 
      xmlns="http://javafx.com/javafx/21" 
      xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.expensetracker.controller.ExpensesController">

    <!-- Filter & Search Bar Card -->
    <VBox styleClass="card" spacing="12">
        <HBox spacing="12" alignment="CENTER_LEFT">
            <!-- Keyword Search -->
            <TextField fx:id="txtSearch" promptText="🔍 Search notes or keywords..." prefWidth="240" />

            <!-- Category Filter -->
            <ComboBox fx:id="comboCategoryFilter" promptText="All Categories" prefWidth="180" />

            <!-- From Date -->
            <DatePicker fx:id="dpFromDate" promptText="From Date" prefWidth="140" />

            <!-- To Date -->
            <DatePicker fx:id="dpToDate" promptText="To Date" prefWidth="140" />

            <!-- Reset Filters -->
            <Button text="Reset" styleClass="btn-secondary" onAction="#handleResetFilters" />

            <Region HBox.hgrow="ALWAYS" />

            <!-- Action Buttons for Selected Row -->
            <Button fx:id="btnEdit" text="✏️ Edit" styleClass="btn-edit" onAction="#handleEditExpense" disable="true" />
            <Button fx:id="btnDelete" text="🗑️ Delete" styleClass="btn-danger" onAction="#handleDeleteExpense" disable="true" />
        </HBox>
    </VBox>

    <!-- Table Card -->
    <VBox styleClass="card" VBox.vgrow="ALWAYS" spacing="12">
        <TableView fx:id="tableExpenses" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colId" text="ID" prefWidth="55.0" />
                <TableColumn fx:id="colAmount" text="Amount" prefWidth="130.0" />
                <TableColumn fx:id="colCategory" text="Category" prefWidth="160.0" />
                <TableColumn fx:id="colDate" text="Date" prefWidth="110.0" />
                <TableColumn fx:id="colPaymentMethod" text="Payment" prefWidth="130.0" />
                <TableColumn fx:id="colNote" text="Note" prefWidth="260.0" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
            <placeholder>
                <Label text="No expense records found matching your filters." />
            </placeholder>
        </TableView>

        <!-- Table Footer / Summary Bar -->
        <HBox alignment="CENTER_LEFT" style="-fx-padding: 6 4 2 4;">
            <Label fx:id="lblSummary" style="-fx-text-fill: #10b981; -fx-font-size: 14px; -fx-font-weight: bold;" 
                   text="Showing 0 expenses  •  Total: ₹ 0.00" />
            <Region HBox.hgrow="ALWAYS" />
            <Label text="💡 Tip: Double-click any row to edit" style="-fx-text-fill: #6b7280; -fx-font-size: 12px;" />
        </HBox>
    </VBox>

</VBox>
