<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="1050.0" 
            stylesheets="@dark-theme.css" 
            xmlns="http://javafx.com/javafx/21" 
            xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="com.expensetracker.controller.MainController">

    <!-- LEFT SIDEBAR -->
    <left>
        <VBox prefWidth="230.0" spacing="8" styleClass="sidebar">
            <!-- Brand / App Title -->
            <VBox spacing="2" style="-fx-padding: 0 0 20 0;">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="₹" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #10b981;" />
                    <Label text="EXPENSE TRACKER" styleClass="brand-title" />
                </HBox>
                <Label text="Personal Finance &amp; Analytics" styleClass="brand-subtitle" />
            </VBox>

            <!-- Navigation Buttons -->
            <Button fx:id="btnDashboard" maxWidth="Infinity" onAction="#handleNavDashboard" 
                    styleClass="nav-btn, nav-btn-active" text="📊   Dashboard" />
            
            <Button fx:id="btnAddExpense" maxWidth="Infinity" onAction="#handleNavAddExpense" 
                    styleClass="nav-btn" text="➕   Add Expense" />
            
            <Button fx:id="btnExpenses" maxWidth="Infinity" onAction="#handleNavExpenses" 
                    styleClass="nav-btn" text="📑   Expenses" />
            
            <Button fx:id="btnAnalytics" maxWidth="Infinity" onAction="#handleNavAnalytics" 
                    styleClass="nav-btn" text="📈   Analytics" />
            
            <Button fx:id="btnBudget" maxWidth="Infinity" onAction="#handleNavBudget" 
                    styleClass="nav-btn" text="🎯   Budget" />

            <Region VBox.vgrow="ALWAYS" />

            <!-- Footer in Sidebar -->
            <Label text="Java 21 • JavaFX • MySQL" style="-fx-text-fill: #4b5563; -fx-font-size: 11px;" />
        </VBox>
    </left>

    <!-- CENTER AREA: Header + Dynamic Content Stack -->
    <center>
        <BorderPane>
            <!-- TOP HEADER BAR -->
            <top>
                <HBox alignment="CENTER_LEFT" spacing="15" styleClass="header-bar">
                    <Label fx:id="lblPageTitle" styleClass="page-title" text="Dashboard" />
                    <Region HBox.hgrow="ALWAYS" />
                    <!-- Database Status Pill -->
                    <Label fx:id="lblDbStatus" styleClass="status-badge" text="● Checking Database..." />
                </HBox>
            </top>

            <!-- DYNAMIC CONTENT VIEW -->
            <center>
                <StackPane fx:id="contentPane" styleClass="content-area" />
            </center>
        </BorderPane>
    </center>

</BorderPane>
